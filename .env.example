# Enterprise HR AI Assistant - Environment Configuration Template
# Copy this file to .env and fill in your API credentials.

APP_NAME="Enterprise HR AI Assistant"
APP_VERSION="2.0.0"

# Groq LLM API Configuration
GROQ_API_KEY="your_groq_api_key_here"
GROQ_MODEL="openai/gpt-oss-120b"

# Supabase PostgreSQL Database Configuration
SUPABASE_URL="https://your_project.supabase.co"
SUPABASE_KEY="your_supabase_anon_or_service_key_here"

# Vector Embedding Configuration
EMBEDDING_MODEL="sentence-transformers/all-MiniLM-L6-v2"

# Application Settings
DEBUG_LOGS=false
